{
  "name": "google-spreadsheet-tables",
  "description": "A TypeScript library that enables using Google Spreadsheets as a simple database with type safety. It provides a type-safe interface using Zod schemas to define table structures and perform CRUD operations on Google Spreadsheets.",
  "version": "1.0.7",
  "type": "module",
  "main": "build/index.js",
  "typings": "build/index.d.ts",
  "module": "build/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "build/",
    "src/"
  ],
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "tsc",
    "fix": "run-s fix:*",
    "fix:lint": "eslint --fix",
    "fix:prettier": "prettier --write src",
    "test": "run-s build test:*",
    "test:lint": "eslint src",
    "test:prettier": "prettier src --list-different",
    "test:cspell": "cspell \"{README.md,.github/*.md,src/**/*.ts}\"",
    "test:unit": "nyc --silent ava",
    "watch": "nyc --silent ava --watch",
    "prepublishOnly": "run-s build"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "ava": "^8.1.2",
    "cspell": "^10.4.0",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "nock": "^15.0.5",
    "npm-run-all": "^4.1.5",
    "nyc": "^18.0.0",
    "prettier": "^3.9.10",
    "standard-version": "^9.5.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "uuid": "^14.0.3"
  },
  "dependencies": {
    "google-auth-library": "^11.3.1",
    "google-spreadsheet": "^5.3.0",
    "zod": "^4.6.7"
  },
  "prettier": {
    "singleQuote": true,
    "semi": false,
    "printWidth": 120
  }
}